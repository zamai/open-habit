{
  "type": "object",
  "properties": {
    "format": {
      "const": "open-habit"
    },
    "formatVersion": {
      "const": 3
    },
    "exportedAt": {
      "type": "string",
      "format": "date-time"
    },
    "dataset": {
      "$ref": "#/$defs/dataset"
    }
  },
  "required": [
    "format",
    "formatVersion",
    "exportedAt",
    "dataset"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Open Habit backup version 3",
  "$defs": {
    "settings": {
      "type": "object",
      "properties": {
        "appearance": {
          "enum": [
            "system",
            "light",
            "dark"
          ]
        },
        "weekStart": {
          "enum": [
            "system",
            "monday",
            "sunday"
          ]
        },
        "examplesDismissed": {
          "type": "boolean"
        }
      },
      "required": [
        "appearance",
        "weekStart",
        "examplesDismissed"
      ]
    },
    "streakGoal": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "period": {
              "const": "daily"
            },
            "target": {
              "const": 1
            }
          },
          "required": [
            "period",
            "target"
          ]
        },
        {
          "type": "object",
          "properties": {
            "period": {
              "const": "weekly"
            },
            "target": {
              "type": "integer",
              "minimum": 1,
              "maximum": 7
            }
          },
          "required": [
            "period",
            "target"
          ]
        }
      ]
    },
    "category": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "icon": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "name",
        "icon",
        "createdAt"
      ]
    },
    "habit": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "emoji": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "color": {
          "enum": [
            "orange",
            "blue",
            "green",
            "pink",
            "purple",
            "teal",
            "red",
            "yellow",
            "indigo",
            "mint",
            "brown"
          ]
        },
        "customColorRGB": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 16777215
        },
        "target": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99
        },
        "streakGoal": {
          "$ref": "#/$defs/streakGoal"
        },
        "categoryIDs": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "uniqueItems": true
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "archived": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "name",
        "emoji",
        "detail",
        "color",
        "target",
        "createdAt",
        "archived"
      ]
    },
    "habitDay": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "count",
        "note"
      ]
    },
    "dataset": {
      "type": "object",
      "properties": {
        "initialized": {
          "type": "boolean"
        },
        "settings": {
          "$ref": "#/$defs/settings"
        },
        "habits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/habit"
          }
        },
        "categories": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/category"
          }
        },
        "days": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[0-9A-F]{8}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{12}/[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/habitDay"
          }
        }
      },
      "required": [
        "initialized",
        "settings",
        "habits",
        "days"
      ]
    }
  }
}
